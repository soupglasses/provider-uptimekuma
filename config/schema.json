                "required": false,
                "sensitive": false,
                "type": [
                  "list",
                  "string"
                ]
              },
              "footer_text": {
                "computed": false,
                "description": "Footer content",
                "optional": true,
                "required": false,
                "sensitive": false,
                "type": "string"
              },
              "google_analytics_id": {
                "computed": false,
                "description": "Google Analytics tracking ID",
                "optional": true,
                "required": false,
                "sensitive": false,
                "type": "string"
              },
              "icon": {
                "computed": false,
                "description": "Icon for the status page. Accepts a PNG data URI (`data:image/png;base64,...`) or a URL/path (max 255 characters). When a data URI is provided, Uptime Kuma converts it to a file on disk.",
                "optional": true,
                "required": false,
                "sensitive": false,
                "type": "string"
              },
              "id": {
                "computed": true,
                "description": "Status page ID",
                "optional": false,
                "required": false,
                "sensitive": false,
                "type": "number"
              },
              "public_group_list": {
                "computed": false,
                "description": "Monitor grouping configuration",
                "nested_type": {
                  "attributes": {
                    "id": {
                      "computed": true,
                      "description": "Public group ID",
                      "optional": true,
                      "required": false,
                      "sensitive": false,
                      "type": "number"
                    },
                    "monitor_list": {
                      "computed": false,
                      "description": "Monitors in group",
                      "nested_type": {
                        "attributes": {
                          "id": {
                            "computed": false,
                            "description": "Monitor ID",
                            "optional": false,
                            "required": true,
                            "sensitive": false,
                            "type": "number"
                          },
                          "send_url": {
                            "computed": false,
                            "description": "Include monitor URL in status page",
                            "optional": true,
                            "required": false,
                            "sensitive": false,
                            "type": "bool"
                          },
                          "url": {
                            "computed": false,
                            "description": "Custom URL to use as the clickable link for this monitor on the status page, overriding the monitor's own check URL. Only takes effect when `send_url` is also set to `true`",
                            "optional": true,
                            "required": false,
                            "sensitive": false,
                            "type": "string"
                          }
                        },
                        "nesting_mode": "list"
                      },
                      "optional": true,
                      "required": false,
                      "sensitive": false
                    },
                    "name": {
                      "computed": false,
                      "description": "Group display name",
                      "optional": false,
                      "required": true,
                      "sensitive": false,
                      "type": "string"
                    },
                    "weight": {
                      "computed": false,
                      "description": "Display order/weight",
                      "optional": true,
                      "required": false,
                      "sensitive": false,
                      "type": "number"
                    }
