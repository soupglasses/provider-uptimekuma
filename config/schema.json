                "required": false,
                "sensitive": false,
                "type": "string"
              },
              "title": {
                "computed": false,
                "description": "Display title",
                "optional": false,
                "required": true,
                "sensitive": false,
                "type": "string"
              }
            }
          },
          "version": 0
        }
      }
    }
  }
